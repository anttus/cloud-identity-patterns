{
  "id": "gke-secret-manager-csi",
  "provider": "gcp",
  "title": "GKE: Secret Manager add-on (CSI)",
  "summary": "The Secret Manager add-on for GKE mounts secrets as files using the pod's Workload Identity Federation principal. IAM can be granted to the Kubernetes service account directly, with no Google service account needed.",
  "notes": [
    "Enable the add-on on the cluster. The SecretProviderClass uses provider: gke and names secrets by their full resource path.",
    "Grant roles/secretmanager.secretAccessor on the individual secret (not the project) to the principal://…/subject/ns/<ns>/sa/<ksa> identifier.",
    "Requires Workload Identity Federation for GKE on the cluster and node pool."
  ],
  "docs": [
    {
      "title": "Use the Secret Manager add-on with GKE",
      "url": "https://cloud.google.com/secret-manager/docs/secret-manager-managed-csi-component"
    },
    {
      "title": "Secret Manager overview",
      "url": "https://cloud.google.com/secret-manager/docs/overview"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "pod",
        "kind": "workload",
        "label": "Pod: orders-api (CSI volume)"
      },
      {
        "id": "csi",
        "kind": "workload",
        "label": "Secret Manager add-on (CSI)"
      },
      {
        "id": "ksa",
        "kind": "k8sServiceAccount",
        "label": "orders/orders-sa"
      },
      {
        "id": "pool",
        "kind": "identityProvider",
        "label": "app-prod.svc.id.goog"
      },
      {
        "id": "secret",
        "kind": "scope",
        "label": "secret: orders-db",
        "properties": {
          "type": "Secret Manager secret"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "kind": "uses",
        "source": "pod",
        "target": "csi",
        "label": "mounts SecretProviderClass"
      },
      {
        "id": "e2",
        "kind": "runsAs",
        "source": "pod",
        "target": "ksa"
      },
      {
        "id": "e3",
        "kind": "runsAs",
        "source": "csi",
        "target": "ksa",
        "label": "as the pod's principal",
        "properties": {
          "SecretProviderClass": "provider: gke"
        }
      },
      {
        "id": "e4",
        "kind": "federatesWith",
        "source": "pool",
        "target": "ksa",
        "label": "identifies as"
      },
      {
        "id": "e5",
        "kind": "hasRoleAssignment",
        "source": "ksa",
        "target": "secret",
        "label": "Secret Accessor (direct)",
        "properties": {
          "role": "roles/secretmanager.secretAccessor",
          "member": "principal://iam.googleapis.com/projects/123/locations/global/workloadIdentityPools/app-prod.svc.id.goog/subject/ns/orders/sa/orders-sa"
        }
      }
    ]
  }
}
