        "label": "kube-apiserver (TokenReview)"
      },
      {
        "id": "role",
        "kind": "roleBinding",
        "label": "Vault role: payments-api",
        "properties": {
          "bound_service_account_names": "api",
          "bound_service_account_namespaces": "payments"
        }
      },
      {
        "id": "policy",
