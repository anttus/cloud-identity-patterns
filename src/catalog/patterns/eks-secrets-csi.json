{
  "id": "eks-secrets-csi",
  "provider": "aws",
  "title": "EKS: Secrets Manager via the Secrets Store CSI driver (ASCP)",
  "summary": "The AWS Secrets and Configuration Provider (ASCP) mounts Secrets Manager or Parameter Store values as files. It calls AWS with the pod's own role, via IRSA or EKS Pod Identity.",
  "notes": [
    "The SecretProviderClass uses provider: aws. Set usePodIdentity: \"true\" to use Pod Identity instead of IRSA.",
    "The role needs secretsmanager:GetSecretValue and secretsmanager:DescribeSecret on the specific secret ARNs, and kms:Decrypt if a customer-managed key encrypts them.",
    "As with the other providers, optional sync to a Kubernetes Secret copies the value into etcd."
  ],
  "docs": [
    {
      "title": "Use Secrets Manager secrets in EKS",
      "url": "https://docs.aws.amazon.com/secretsmanager/latest/userguide/integrating_ascp_irsa.html"
    },
    {
      "title": "AWS Secrets and Configuration Provider (ASCP)",
      "url": "https://github.com/aws/secrets-store-csi-driver-provider-aws"
    },
    {
      "title": "Secrets Store CSI Driver (Kubernetes SIG project)",
      "url": "https://secrets-store-csi-driver.sigs.k8s.io/"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "pod",
        "kind": "workload",
        "label": "Pod: orders-api (CSI volume)"
      },
      {
        "id": "csi",
        "kind": "workload",
        "label": "Secrets Store CSI driver + ASCP"
      },
      {
        "id": "ksa",
        "kind": "k8sServiceAccount",
        "label": "orders/orders-sa"
      },
      {
        "id": "role",
        "kind": "iamRole",
        "label": "orders-api"
      },
      {
        "id": "secret",
        "kind": "scope",
        "label": "secret: orders/db",
        "properties": {
          "type": "Secrets Manager secret"
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "kind": "uses",
        "source": "pod",
        "target": "csi",
        "label": "mounts SecretProviderClass"
      },
      {
        "id": "e2",
        "kind": "runsAs",
        "source": "pod",
        "target": "ksa"
      },
      {
        "id": "e3",
        "kind": "runsAs",
        "source": "ksa",
        "target": "role",
        "label": "IRSA or Pod Identity"
      },
      {
        "id": "e4",
        "kind": "runsAs",
        "source": "csi",
        "target": "role",
        "label": "as the pod's role",
        "properties": {
          "SecretProviderClass": "provider: aws, usePodIdentity: \"true\" (optional)"
        }
      },
      {
        "id": "e5",
        "kind": "hasRoleAssignment",
        "source": "role",
        "target": "secret",
        "label": "GetSecretValue + DescribeSecret",
        "properties": {
          "role": "orders-api-policy"
        }
      }
    ]
  }
}
