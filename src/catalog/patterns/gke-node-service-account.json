{
  "id": "gke-node-service-account",
  "provider": "gcp",
  "title": "GKE: node service account and the metadata server",
  "summary": "Nodes run as a Google service account. With Workload Identity Federation for GKE enabled, the GKE metadata server intercepts pod requests, so pods get their own identity instead of the node's.",
  "notes": [
    "Don't use the Compute Engine default service account: in many projects it still holds the broad Editor role. Create a dedicated node service account with roles/container.defaultNodeServiceAccount plus read access to your image registries.",
    "Workload Identity Federation for GKE is what keeps pods away from node credentials. Node pools without the GKE metadata server expose the node service account to every pod.",
    "Unlike AKS and EKS, the protection comes with the workload identity feature itself rather than a separate network setting."
  ],
  "docs": [
    {
      "title": "Harden your cluster: least-privilege node service account",
      "url": "https://cloud.google.com/kubernetes-engine/docs/how-to/hardening-your-cluster#use_least_privilege_sa"
    },
    {
      "title": "Service accounts in GKE",
      "url": "https://cloud.google.com/kubernetes-engine/docs/how-to/service-accounts"
    },
    {
      "title": "Protect cluster metadata",
      "url": "https://cloud.google.com/kubernetes-engine/docs/how-to/protecting-cluster-metadata"
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "pool",
        "kind": "workload",
        "label": "Node pool (GKE metadata server on)"
      },
      {
        "id": "sa",
        "kind": "serviceAccount",
        "label": "gke-nodes@app-prod.iam.gserviceaccount.com"
      },
      {
        "id": "project",
        "kind": "scope",
        "label": "app-prod (project)",
        "properties": {
          "type": "GCP project"
        }
      },
      {
        "id": "ar",
        "kind": "scope",
        "label": "Artifact Registry: images",
        "properties": {
          "type": "Artifact Registry repository"
        }
      },
      {
        "id": "pod",
        "kind": "workload",
        "label": "Any pod on the node"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "kind": "attachedTo",
        "source": "sa",
        "target": "pool"
      },
      {
        "id": "e2",
        "kind": "hasRoleAssignment",
        "source": "sa",
        "target": "project",
        "label": "Default Node Service Account",
        "properties": {
          "role": "roles/container.defaultNodeServiceAccount"
        }
      },
      {
        "id": "e3",
        "kind": "hasRoleAssignment",
        "source": "sa",
        "target": "ar",
        "label": "Artifact Registry Reader",
        "properties": {
          "role": "roles/artifactregistry.reader"
        }
      },
      {
        "id": "e4",
        "kind": "uses",
        "source": "pod",
        "target": "sa",
        "label": "blocked by GKE metadata server",
        "properties": {
          "pods receive": "their own KSA-based identity instead"
        }
      }
    ]
  }
}
